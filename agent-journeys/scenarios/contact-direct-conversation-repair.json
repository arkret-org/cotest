{
  "schema_version": "v1",
  "id": "contact-direct-conversation-repair",
  "title": "Two contacts found one Direct Conversation and repair it in place",
  "required_topology": "federated",
  "intent": "Exercise directional Contact establishment, deterministic first-chat founding, encrypted messaging, holder-private blocking, leave and self-rejoin repair, and coordinate reuse across two principal servers.",
  "source_flows": [
    "contact-lineage-model",
    "contact-direct-conversation-lifecycle",
    "message-authoring-seal-sync",
    "realm-event-server-fanout"
  ],
  "actors": [
    {
      "id": "alice",
      "site": "alpha",
      "role": "contact requester"
    },
    {
      "id": "bob",
      "site": "beta",
      "role": "contact responder and derived founder"
    },
    {
      "id": "david",
      "site": "beta",
      "role": "unrelated privacy probe"
    }
  ],
  "agent_constraints": {
    "mutation_surface": "visible-ui-only",
    "read_only_oracles_allowed": true,
    "max_attempts_per_checkpoint": 3,
    "allow_testid_locators": false,
    "allow_dom_eval_for_actions": false,
    "require_semantic_snapshot_before_action": true
  },
  "checkpoints": [
    {
      "id": "DCR01",
      "actor": "harness",
      "phase": "topology",
      "goal": "Verify Alice and Bob are attached to isolated alpha and beta principal servers with distinct browser profiles.",
      "required": true,
      "hard_checks": [
        "alpha-beta-service-id-distinct",
        "alice-bob-browser-state-isolated",
        "explicit-peer-link-present"
      ]
    },
    {
      "id": "DCR02",
      "actor": "alice",
      "phase": "contact-request",
      "goal": "Find Bob through visible contact discovery, send one request granting direct-message scope, and observe a pending state without opening a conversation early.",
      "required": true,
      "hard_checks": [
        "bob-identity-selected",
        "contact-request-sent-once",
        "contact-request-pending",
        "conversation-not-created-before-contact-ready"
      ]
    },
    {
      "id": "DCR03",
      "actor": "bob",
      "phase": "contact-response",
      "goal": "Discover Alice's incoming request without a direct URL, grant reciprocal direct-message scope, and accept it once.",
      "required": true,
      "hard_checks": [
        "alice-request-visible-to-bob",
        "reciprocal-direct-message-scope-visible",
        "contact-response-accepted-once",
        "contact-ready-visible-to-bob"
      ]
    },
    {
      "id": "DCR04",
      "actor": "alice",
      "phase": "contact-convergence",
      "goal": "Refresh contact state and verify Bob is ready for direct messaging while the product does not ask Alice to choose a Realm coordinate or server URL.",
      "required": true,
      "hard_checks": [
        "contact-ready-visible-to-alice",
        "direct-message-action-enabled",
        "no-realm-coordinate-input-required",
        "no-server-url-input-required"
      ]
    },
    {
      "id": "DCR05",
      "actor": "bob",
      "phase": "first-chat",
      "goal": "Open Alice from Contacts as the derived founder, wait for encrypted first-chat readiness, and publish a uniquely tagged greeting.",
      "required": true,
      "hard_checks": [
        "direct-conversation-created-once",
        "main-discussion-visible",
        "encrypted-readiness-visible",
        "bob-greeting-visible"
      ]
    },
    {
      "id": "DCR06",
      "actor": "alice",
      "phase": "encrypted-conversation",
      "goal": "Open Bob from Contacts without a direct URL, observe Bob's greeting, reply once, reload, and return to the same conversation.",
      "required": true,
      "hard_checks": [
        "bob-greeting-visible-to-alice",
        "alice-reply-visible",
        "same-conversation-after-reload",
        "no-second-conversation-created"
      ]
    },
    {
      "id": "DCR07",
      "actor": "alice",
      "phase": "holder-private-block",
      "goal": "Use the visible personal block control for Bob and verify that Bob's conversation is hidden or suppressed locally without presenting the action as shared membership removal.",
      "required": true,
      "hard_checks": [
        "bob-added-to-personal-blocklist",
        "conversation-suppressed-for-alice",
        "no-shared-leave-presented",
        "personal-setting-persists-after-reload"
      ]
    },
    {
      "id": "DCR08",
      "actor": "bob",
      "phase": "blocked-peer-behavior",
      "goal": "Publish one uniquely tagged message while Alice's holder-private block is active and verify Bob is not told whether Alice blocked him.",
      "required": true,
      "hard_checks": [
        "bob-message-accepted-once",
        "no-block-notification-visible-to-bob",
        "no-block-state-disclosed-to-bob",
        "conversation-coordinate-unchanged"
      ]
    },
    {
      "id": "DCR09",
      "actor": "alice",
      "phase": "unblock",
      "goal": "Remove Bob from the personal blocklist and verify the same conversation and Bob's retained message become visible again.",
      "required": true,
      "hard_checks": [
        "bob-removed-from-personal-blocklist",
        "same-conversation-restored",
        "blocked-period-message-visible",
        "history-not-recreated"
      ]
    },
    {
      "id": "DCR10",
      "actor": "bob",
      "phase": "leave",
      "goal": "Use the visible shared leave action, verify sending stops, and confirm the product retains a suspended conversation entry rather than silently creating a replacement.",
      "required": true,
      "hard_checks": [
        "bob-membership-left",
        "bob-send-disabled",
        "conversation-shown-as-suspended",
        "conversation-coordinate-retained"
      ]
    },
    {
      "id": "DCR11",
      "actor": "bob",
      "phase": "repair",
      "goal": "Re-enter the Direct Conversation through its visible repair action, wait for encrypted readiness, and publish a uniquely tagged repaired-session message.",
      "required": true,
      "hard_checks": [
        "self-rejoin-completed",
        "encrypted-readiness-restored",
        "repaired-message-visible",
        "same-realm-and-main-discussion-reused"
      ]
    },
    {
      "id": "DCR12",
      "actor": "david",
      "phase": "privacy",
      "goal": "Attempt to discover Alice and Bob's Direct Conversation without being a participant.",
      "required": true,
      "hard_checks": [
        "direct-conversation-not-discoverable",
        "direct-conversation-content-not-readable",
        "pair-coordinate-not-leaked"
      ]
    },
    {
      "id": "DCR13",
      "actor": "harness",
      "phase": "read-only-oracle",
      "goal": "Confirm one stable pair coordinate, one Realm, one main discussion, directional current Contact proofs, and a later repair generation without using the oracle to mutate the story.",
      "required": true,
      "hard_checks": [
        "directional-contact-proofs-current",
        "one-stable-pair-coordinate",
        "one-direct-conversation-realm",
        "one-main-discussion",
        "repair-generation-advanced"
      ]
    }
  ]
}
