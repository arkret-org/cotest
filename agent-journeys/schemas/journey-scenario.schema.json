{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/cotest/agent-journey-scenario.v1.schema.json",
  "title": "Arkret Agent Journey Scenario",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "required_topology",
    "intent",
    "source_flows",
    "actors",
    "agent_constraints",
    "checkpoints"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "required_topology": {
      "enum": [
        "single",
        "federated"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "source_flows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "site",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "site": {
            "enum": [
              "alpha",
              "beta"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "agent_constraints": {
      "type": "object",
      "required": [
        "mutation_surface",
        "read_only_oracles_allowed",
        "max_attempts_per_checkpoint",
        "allow_testid_locators",
        "allow_dom_eval_for_actions",
        "require_semantic_snapshot_before_action"
      ],
      "properties": {
        "mutation_surface": {
          "const": "visible-ui-only"
        },
        "read_only_oracles_allowed": {
          "type": "boolean"
        },
        "max_attempts_per_checkpoint": {
          "type": "integer",
          "minimum": 1
        },
        "allow_testid_locators": {
          "type": "boolean"
        },
        "allow_dom_eval_for_actions": {
          "type": "boolean"
        },
        "require_semantic_snapshot_before_action": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "phase",
          "goal",
          "required",
          "hard_checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "hard_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
