{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/cotest/agent-journey-result.v1.schema.json",
  "title": "Arkret Agent Journey Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "topology",
    "status",
    "started_at",
    "checkpoints"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "enum": [
        "single",
        "federated"
      ]
    },
    "status": {
      "enum": [
        "RUNNING",
        "PASS",
        "PRODUCT_FAIL",
        "AGENT_FAIL",
        "HARNESS_FAIL",
        "INCONCLUSIVE"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "required",
          "status",
          "hard_checks",
          "attempts"
        ],
        "properties": {
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "PRODUCT_FAIL",
              "AGENT_FAIL",
              "HARNESS_FAIL",
              "INCONCLUSIVE"
            ]
          },
          "hard_checks": {
            "type": "array"
          },
          "screenshot": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

