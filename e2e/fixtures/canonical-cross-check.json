{
  "_comment": "Cross-language canonical JSON golden vectors. `canonical` is the authoritative output of the SDK (cokret_core::canonical, RFC 8785 JCS / integer-only profile) and is asserted byte-for-byte by BOTH sides: the Rust gate src/conformance/canonical_cross_lang.rs (re-derives via cokret_core::canonical) and the TS helper test e2e/tests/conformance/canonical-cross-lang.spec.ts (re-derives via canonicalJson in e2e/helpers/soland-api.ts). If either implementation drifts, the corresponding side fails. Regenerate `canonical` with the SDK if the canonical profile changes; never hand-edit it.",
  "vectors": [
    {
      "canonical": "{\"a\":1,\"b\":2,\"c\":{\"y\":25,\"z\":26}}",
      "value": {
        "a": 1,
        "b": 2,
        "c": {
          "y": 25,
          "z": 26
        }
      }
    },
    {
      "canonical": "{\"list\":[3,2,1],\"nested\":[{\"k\":\"v\"},{\"a\":[true,false,null]}]}",
      "value": {
        "list": [
          3,
          2,
          1
        ],
        "nested": [
          {
            "k": "v"
          },
          {
            "a": [
              true,
              false,
              null
            ]
          }
        ]
      }
    },
    {
      "canonical": "{\"int_max\":9007199254740991,\"int_min\":-9007199254740991,\"neg\":-7,\"zero\":0}",
      "value": {
        "int_max": 9007199254740991,
        "int_min": -9007199254740991,
        "neg": -7,
        "zero": 0
      }
    },
    {
      "canonical": "{\"ascii\":\"hello world\",\"name\":\"café\",\"zh\":\"你好\"}",
      "value": {
        "ascii": "hello world",
        "name": "café",
        "zh": "你好"
      }
    },
    {
      "canonical": "{\"empty_arr\":[],\"empty_obj\":{},\"flag\":true,\"missing\":null}",
      "value": {
        "empty_arr": [],
        "empty_obj": {},
        "flag": true,
        "missing": null
      }
    },
    {
      "canonical": "\"just a string\"",
      "value": "just a string"
    },
    {
      "canonical": "12345",
      "value": 12345
    },
    {
      "canonical": "[1,2,3]",
      "value": [
        1,
        2,
        3
      ]
    }
  ]
}
