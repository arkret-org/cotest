{
  "name": "cotest-joint-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --config playwright.config.ts",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "typecheck": "tsc --noEmit",
    "gen:wire-types": "node scripts/generate-wire-types.mjs",
    "check:wire-types": "node scripts/generate-wire-types.mjs --check",
    "check:fixme": "node scripts/check-fixme-quality.mjs",
    "check:provisioning-cache": "node --test scripts/provisioning-cache.test.mjs"
  },
  "devDependencies": {
    "@noble/ciphers": "^1.3.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
