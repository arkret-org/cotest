{
  "comment": "T-P0-04 baseline requests for comparing yougen's e2e mock contract with a live soland process.",
  "cases": [
    {
      "id": "server_describe",
      "method": "GET",
      "path": "/_cokret/describe"
    },
    {
      "id": "events_submit",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "headers": { "x-cokret-request-id": "mock-parity-events-submit" },
      "body_template": "realm_create_event"
    },
    {
      "id": "events_list",
      "method": "GET",
      "path": "/_cokret/self/events?realms=${realm_id}&limit=20",
      "auth": "alice"
    },
    {
      "id": "account_profile",
      "method": "GET",
      "path": "/_soland/self/account/me",
      "auth": "alice"
    },
    {
      "id": "realm_create",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_2"
    },
    {
      "id": "space_create",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_3"
    },
    {
      "id": "directory_describe",
      "method": "GET",
      "path": "/_cokret/find/directory/describe"
    },
    {
      "id": "directory_search_realms",
      "method": "POST",
      "path": "/_cokret/find/directory/search-realms",
      "body": { "query": "Mock Parity", "limit": 20 }
    },
    {
      "id": "keys_backups",
      "method": "GET",
      "path": "/_cokret/self/keys/backups",
      "auth": "alice"
    },
    {
      "id": "devices_pairing_challenge",
      "method": "POST",
      "path": "/_cokret/self/devices/pairing-challenge",
      "auth": "alice",
      "body": { "device_id": "ck:device:01904100-0000-7000-8000-0000000000b2" }
    },
    {
      "id": "ephemeral",
      "method": "POST",
      "path": "/_cokret/self/ephemeral",
      "auth": "alice",
      "body_template": "typing_ephemeral"
    }
  ]
}
