{
  "profile": "cx.profile.anchorer_cell_vectors.v1",
  "version": "2026-05-09",
  "inherits": ["_shared/_canonical_dids.json"],
  "comment": "Anchorer cell governance vectors per spec authz/event-auth-state-resolution.md §6.4 (anchorer profiles, split-anchorer Bottom, signature mismatch, threshold-below-quorum). The anchorer cell is `ck:cell:cx.component.anchorer.v1:<space_id>`, a cas-register holding the anchorer profile descriptor (single_did | threshold k-of-n | open_set | mixed). Each happy-path vector pins a single anchored Move that sets the cell to a normative AnchorerValue shape; concurrent reconfigurations (split anchorer) MUST surface Bottom — Space-wide pause condition, not LWW. Negative vectors cover signature mismatch and threshold-below-quorum admission errors. The validator is structural: it doesn't verify the lattice round-trip itself (that's `lattice_round_trip.rs::anchorer_cell_*`); it asserts each declared input has the spec-mandated shape and each negative vector carries the correct rejection reason.",
  "encoder": {
    "anchorer_cell_id": "ck:cell:cx.component.anchorer.v1:<space_id>",
    "lattice": "cas_register",
    "bottom_kind_on_split": "Conflict"
  },
  "vectors": [
    {
      "name": "single_did_happy_path",
      "shape": "single_did",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp01000000000000000000",
      "anchorer_value": {
        "shape": "single_did",
        "did": "did:web:hub.example"
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a07-8007-000000000007",
        "op_type": "set"
      },
      "expected": {
        "outcome": "value",
        "rationale": "single anchored set on a cas-register with no concurrent peer ⇒ Value (no Bottom)."
      }
    },
    {
      "name": "threshold_k_of_n_happy_path",
      "shape": "threshold",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp02000000000000000000",
      "anchorer_value": {
        "shape": "threshold",
        "k": 2,
        "n": 3,
        "members": [
          "did:web:anchor1.example",
          "did:web:anchor2.example",
          "did:web:anchor3.example"
        ]
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a08-8008-000000000008",
        "op_type": "set"
      },
      "expected": {
        "outcome": "value",
        "rationale": "k-of-n threshold descriptor is admissible (2 ≤ 3 = n, k ≥ majority of allowed-set fan-in)."
      }
    },
    {
      "name": "open_set_happy_path",
      "shape": "open_set",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp03000000000000000000",
      "anchorer_value": {
        "shape": "open_set",
        "members": [
          "did:web:peer1.example",
          "did:web:peer2.example"
        ]
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a09-8009-000000000009",
        "op_type": "set"
      },
      "expected": {
        "outcome": "value",
        "rationale": "open_set treats every member as an independent anchorer (federation peer-mesh form)."
      }
    },
    {
      "name": "mixed_recovery_happy_path",
      "shape": "mixed",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp04000000000000000000",
      "anchorer_value": {
        "shape": "mixed",
        "primary": "did:web:hub.example",
        "recovery_members": [
          "did:web:recovery1.example",
          "did:web:recovery2.example"
        ]
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a0a-800a-00000000000a",
        "op_type": "set"
      },
      "expected": {
        "outcome": "value",
        "rationale": "mixed = primary single_did with recovery_members fallback set; lattice still resolves to a single Value."
      }
    },
    {
      "name": "concurrent_reconfig_returns_bottom_conflict",
      "shape": "single_did",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp05000000000000000000",
      "concurrent_anchored_ops": [
        {
          "move_id": "ck:event:01970e58-0001-7a0b-800b-00000000000b",
          "op_type": "set",
          "value": {
            "shape": "single_did",
            "did": "did:web:hub-a.example"
          }
        },
        {
          "move_id": "ck:event:01970e58-0001-7a0c-800c-00000000000c",
          "op_type": "set",
          "value": {
            "shape": "single_did",
            "did": "did:web:hub-b.example"
          }
        }
      ],
      "expected": {
        "outcome": "bottom",
        "bottom_kind": "Conflict",
        "rationale": "Two admins concurrently reconfigure the anchorer; cas-register surfaces Bottom because a split anchorer is a Space-wide pause condition (not LWW). Recovery requires a higher-authority Move from a recovery_capability holder."
      }
    }
  ],
  "negative_vectors": [
    {
      "name": "signature_mismatch_rejected",
      "shape": "single_did",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp06000000000000000000",
      "anchorer_value": {
        "shape": "single_did",
        "did": "did:web:hub.example"
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a0d-800d-00000000000d",
        "op_type": "set"
      },
      "drift": {
        "kind": "signature_mismatch",
        "signature": {
          "alg": "EdDSA",
          "kid": "did:web:hub.example#key-1",
          "value": "deadbeef-not-a-real-sig"
        },
        "signing_key_did": "did:web:attacker.example"
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "anchor_signature_invalid",
        "rationale": "Signature validates against did:web:attacker.example, not the cell's `single_did` value did:web:hub.example. verify_move MUST reject before the cas-register sees the op."
      }
    },
    {
      "name": "threshold_below_quorum_rejected",
      "shape": "threshold",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp07000000000000000000",
      "anchorer_value": {
        "shape": "threshold",
        "k": 2,
        "n": 3,
        "members": [
          "did:web:anchor1.example",
          "did:web:anchor2.example",
          "did:web:anchor3.example"
        ]
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a0e-800e-00000000000e",
        "op_type": "set"
      },
      "drift": {
        "kind": "threshold_below_quorum",
        "signatures_present": 1,
        "k_required": 2
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "anchor_threshold_below_quorum",
        "rationale": "Only 1 signature is present but k=2 are required; verify_move enforces threshold quorum before admitting the op."
      }
    },
    {
      "name": "kn_geometry_violation_rejected",
      "shape": "threshold",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp08000000000000000000",
      "anchorer_value": {
        "shape": "threshold",
        "k": 4,
        "n": 3,
        "members": [
          "did:web:anchor1.example",
          "did:web:anchor2.example",
          "did:web:anchor3.example"
        ]
      },
      "anchored_op": {
        "move_id": "ck:event:01970e58-0001-7a0f-800f-00000000000f",
        "op_type": "set"
      },
      "drift": {
        "kind": "threshold_geometry_invalid",
        "k": 4,
        "n": 3
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "anchor_threshold_geometry_invalid",
        "rationale": "k=4 > n=3 is structurally impossible (cannot collect 4 sigs from 3 members). The anchorer cell descriptor MUST fail admission before being written."
      }
    },
    {
      "name": "missing_cell_family_for_anchorer_kind_rejected",
      "shape": "single_did",
      "cell_id": "ck:cell:cx.component.anchorer.v1:cx.realm.01js0sp09000000000000000000",
      "anchorer_value": {
        "shape": "single_did",
        "did": "did:web:hub.example"
      },
      "drift": {
        "kind": "registry_drift",
        "missing_field": "cell_family",
        "registry_kind": "cx.anchorer.set"
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "registry_kind_missing_cell_family",
        "rationale": "Negative-fixture canary for the M11 registry validator: a hypothetical anchorer-set kind without `cell_family` MUST be rejected by `validate_event_kind_registry`."
      }
    }
  ]
}
