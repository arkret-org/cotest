{
  "suite": "principal_server_certification_gate",
  "profile": "ak.profile.principal_server_certification_gate.v1",
  "cases": [
    {
      "name": "soland_reports_principal_server_not_certified_with_signed_retry_boundary",
      "expect": "not_certified",
      "describe": {
        "service": "soland",
        "service_type": "principal_server",
        "supported_profiles": [
          "ak.profile.principal_server_events_api.v1"
        ],
        "certification": {
          "principal_server": {
            "status": "not_certified",
            "reason": "full profile remains gated until every production surface is enabled"
          }
        },
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": true,
            "retry_worker": true,
            "dead_letter_audit": true
          }
        },
        "limitations": [
          {
            "feature": "principal_server_full_profile",
            "status": "not_certified"
          }
        ]
      }
    },
    {
      "name": "full_principal_server_claim_without_durable_federation_is_rejected",
      "expect": "reject",
      "describe": {
        "service": "candidate",
        "supported_profiles": [
          "ak.profile.principal_server.v1"
        ],
        "certification": {
          "principal_server": {
            "status": "certified"
          }
        },
        "supported_operations": [
          "ak.server.query.describe",
          "ak.self.account.query.describe",
          "ak.self.account.stream.subscribe",
          "ak.self.events.stream.subscribe",
          "ak.self.events.query.scan",
          "ak.self.snapshot.query.manifest_head",
          "ak.self.authz.query.check"
        ],
        "supported_event_kinds": [
          "ak.space.create",
          "ak.member.state",
          "ak.strand.create",
          "ak.message.create",
          "ak.capability.grant",
          "ak.capability.revoke"
        ],
        "supported_schemas": [
          "ak.schema.account_subscribe_frame.v1",
          "ak.schema.snapshot.v1",
          "ak.schema.capability.v1",
          "ak.schema.grant_constraint.v1"
        ],
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": false,
            "retry_worker": false,
            "dead_letter_audit": false
          }
        },
        "principal_server_minimum": {
          "admin": {"status": "supported"},
          "agent": {"status": "supported"},
          "applet": {"status": "supported"},
          "media": {"status": "supported"}
        }
      }
    },
    {
      "name": "full_principal_server_claim_requires_all_minimum_surfaces",
      "expect": "certified",
      "describe": {
        "service": "certified-reference",
        "supported_profiles": [
          "ak.profile.principal_server.v1"
        ],
        "certification": {
          "principal_server": {
            "status": "certified"
          }
        },
        "supported_operations": [
          "ak.server.query.describe",
          "ak.self.account.query.describe",
          "ak.self.account.stream.subscribe",
          "ak.self.events.stream.subscribe",
          "ak.self.events.query.scan",
          "ak.self.snapshot.query.manifest_head",
          "ak.self.authz.query.check",
          "ak.self.blob.upload.create",
          "ak.self.agent.command.provision",
          "ak.self.applet.command.install",
          "ak.self.media.query.ice_config"
        ],
        "supported_event_kinds": [
          "ak.space.create",
          "ak.member.state",
          "ak.strand.create",
          "ak.message.create",
          "ak.capability.grant",
          "ak.capability.revoke"
        ],
        "supported_schemas": [
          "ak.schema.account_subscribe_frame.v1",
