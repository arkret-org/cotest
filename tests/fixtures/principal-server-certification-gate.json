{
  "suite": "principal_server_certification_gate",
  "profile": "ck.profile.principal_server_certification_gate.v1",
  "cases": [
    {
      "name": "soland_reports_principal_server_not_certified_with_signed_retry_boundary",
      "expect": "not_certified",
      "describe": {
        "service": "soland",
        "service_type": "principal_server",
        "supported_profiles": [
          "ck.profile.principal_server_events_api.v1"
        ],
        "certification": {
          "principal_server": {
            "status": "not_certified",
            "reason": "full profile remains gated until every production surface is enabled"
          }
        },
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": true,
            "retry_worker": true,
            "dead_letter_audit": true
          }
        },
        "limitations": [
          {
            "feature": "principal_server_full_profile",
            "status": "not_certified"
          }
        ]
      }
    },
    {
