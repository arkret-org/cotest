        "supported_profiles": [
          "ck.profile.principal_server.v1"
        ],
        "certification": {
          "principal_server": {
            "status": "certified"
          }
        },
        "supported_operations": [
          "ck.server.describe",
          "ck.self.account.describe",
          "ck.self.account.subscribe",
          "ck.self.events.subscribe",
          "ck.self.events.query",
          "ck.self.snapshot.head",
          "ck.self.authz.check"
        ],
        "supported_event_kinds": [
          "ck.space.create",
