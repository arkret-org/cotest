          "ck.flow.create",
          "ck.message.create",
          "ck.capability.grant",
          "ck.capability.revoke"
        ],
        "supported_schemas": [
          "ck.schema.account_subscribe_frame.v1",
          "ck.schema.snapshot.v1",
          "ck.schema.capability.v1",
          "ck.schema.grant_constraint.v1"
        ],
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": false,
            "retry_worker": false,
            "dead_letter_audit": false
