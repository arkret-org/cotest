{
  "suite": "station_certification_gate",
  "profile": "ak.profile.station_certification_gate.v1",
  "cases": [
    {
      "name": "coland_reports_station_not_certified_with_signed_retry_boundary",
      "expect": "not_certified",
      "describe": {
        "service": "coland",
        "service_kind": "station",
        "supported_profiles": [
          "ak.profile.station_events_api.v1"
        ],
        "certification": {
          "station": {
            "status": "not_certified",
            "reason": "full profile remains gated until every production surface is enabled"
          }
        },
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": true,
            "retry_worker": true,
            "dead_letter_audit": true
          }
        },
        "limitations": [
          {
            "feature": "station_full_profile",
            "status": "not_certified"
          }
        ]
      }
    },
    {
      "name": "full_station_claim_without_durable_federation_is_rejected",
      "expect": "reject",
      "describe": {
        "service": "candidate",
        "supported_profiles": [
          "ak.profile.station.v1"
        ],
        "certification": {
          "station": {
            "status": "certified"
          }
        },
        "supported_operation_bundles": [
          "ak.operation_bundle.station.describe.v1",
          "ak.operation_bundle.station.http_core_current.v1"
        ],
        "supported_event_kinds": [
          "ak.space.create",
          "ak.member.state",
          "ak.strand.create",
          "ak.message.create",
          "ak.capability.grant",
          "ak.capability.revoke"
        ],
        "supported_schemas": [
          "ak.schema.account_subscribe_frame.v1",
          "ak.schema.realm_state_snapshot.v1",
          "ak.schema.capability.v1",
          "ak.schema.grant_constraint.v1"
        ],
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": false,
            "retry_worker": false,
            "dead_letter_audit": false
          }
        },
        "station_minimum": {
          "admin": {"status": "supported"},
          "agent": {"status": "supported"},
          "applet": {"status": "supported"},
          "media": {"status": "supported"}
        }
      }
    },
    {
      "name": "full_station_claim_requires_all_minimum_surfaces",
      "expect": "certified",
      "describe": {
        "service": "certified-reference",
        "supported_profiles": [
          "ak.profile.station.v1"
        ],
        "certification": {
          "station": {
            "status": "certified"
          }
        },
        "supported_operation_bundles": [
          "ak.operation_bundle.station.describe.v1",
          "ak.operation_bundle.station.http_core_current.v1",
          "ak.operation_bundle.station.agent_runtime.v1",
          "ak.operation_bundle.station.applet_install.v1"
        ],
        "supported_event_kinds": [
          "ak.space.create",
          "ak.member.state",
          "ak.strand.create",
          "ak.message.create",
          "ak.capability.grant",
          "ak.capability.revoke"
        ],
        "supported_schemas": [
          "ak.schema.account_subscribe_frame.v1",
          "ak.schema.realm_state_snapshot.v1",
          "ak.schema.capability.v1",
          "ak.schema.grant_constraint.v1"
        ],
        "federation": {
          "outbound": {
            "http_message_signatures": true,
            "durable_retry_queue": true,
            "retry_worker": true,
            "dead_letter_audit": true
          }
        },
        "station_minimum": {
          "admin": {"status": "supported"},
          "agent": {"status": "supported"},
          "applet": {"status": "supported"},
          "media": {"status": "supported"}
        }
      }
    }
  ]
}
