{
  "suite": "scaffold_profile_gate",
  "profile": "ak.vector_group.privacy_security.v1",
  "cases": [
    {
      "name": "coauth_admin_full_claim_with_501_is_rejected",
      "expect": "reject",
      "describe": {
        "service": "coauth",
        "supported_profiles": ["ak.profile.principal_server.v1"],
        "admin_surfaces": [
          {
            "path": "/api/admin/v1/devices",
            "status": 501,
            "stability": "scaffold"
          }
        ]
      }
    },
    {
      "name": "inkson_full_e2ee_claim_with_placeholder_crypto_is_rejected",
      "expect": "reject",
      "describe": {
        "service": "inkson",
        "supported_profiles": [
          "ak.profile.full_client.v1",
          "ak.profile.e2ee_client.v1"
        ],
        "client_status": {
          "production_fallbacks": [
            "legacy placeholder ciphertext",
            "demo ed25519 signing"
          ]
        }
      }
    },
    {
      "name": "soland_principal_claim_with_outbound_push_scaffold_is_rejected",
      "expect": "reject",
      "describe": {
        "service": "soland",
        "supported_profiles": ["ak.profile.principal_server.v1"],
        "limits": {
          "profile_status": {
            "limitations": [
              {
                "area": "federation.outbound_push",
                "stability": "scaffold",
                "reason": "durable outbound fanout is not implemented"
              }
            ]
          }
        }
      }
    },
    {
      "name": "soland_limited_profile_in_unsupported_with_limitation_is_allowed",
      "expect": "pass",
      "describe": {
        "service": "soland",
        "supported_profiles": ["ak.profile.mimi_interop.v1"],
        "unsupported_profiles": [
          {
            "profile": "ak.profile.principal_server.v1",
            "status": "unsupported",
            "reason": "durable outbound fanout is not claimed"
          }
        ],
        "limits": {
          "profile_status": {
            "limitations": [
              {
                "area": "federation.outbound_push",
                "reason": "durable outbound fanout is not claimed"
              }
            ]
          }
        }
      }
    }
  ]
}
