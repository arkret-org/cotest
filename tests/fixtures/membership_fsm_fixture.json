{
  "profile": "ak.profile.membership_fsm_vectors.v1",
  "version": "2026-09-01",
  "comment": "Canonical four-state ak.fsm.membership.v1 vectors. Invite lifecycle is independent and never appears as an ak.member.state value; authorization is evaluated outside the structural FSM.",
  "encoder": {
    "cell_family": "ak.component.member.state.v1",
    "lattice": "fsm",
    "bottom": "reject",
    "states": ["join", "knock", "leave", "ban"]
  },
  "legal_transitions": [
    {"name":"leave_to_knock","from":"leave","to":"knock","actor":"self","expected":{"outcome":"accept","next_state":"knock"}},
    {"name":"leave_to_join","from":"leave","to":"join","actor":"self","expected":{"outcome":"accept","next_state":"join"}},
    {"name":"knock_to_join","from":"knock","to":"join","actor":"admin","expected":{"outcome":"accept","next_state":"join"}},
    {"name":"knock_to_leave","from":"knock","to":"leave","actor":"self","expected":{"outcome":"accept","next_state":"leave"}},
    {"name":"join_to_leave","from":"join","to":"leave","actor":"self","expected":{"outcome":"accept","next_state":"leave"}},
    {"name":"leave_to_ban","from":"leave","to":"ban","actor":"admin","expected":{"outcome":"accept","next_state":"ban"}},
    {"name":"knock_to_ban","from":"knock","to":"ban","actor":"admin","expected":{"outcome":"accept","next_state":"ban"}},
    {"name":"join_to_ban","from":"join","to":"ban","actor":"admin","expected":{"outcome":"accept","next_state":"ban"}},
    {"name":"ban_to_leave","from":"ban","to":"leave","actor":"admin","expected":{"outcome":"accept","next_state":"leave"}}
  ],
  "illegal_transitions": [
    {"name":"join_to_join","from":"join","to":"join","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"knock_to_knock","from":"knock","to":"knock","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"leave_to_leave","from":"leave","to":"leave","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"ban_to_ban","from":"ban","to":"ban","actor":"admin","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"ban_to_join","from":"ban","to":"join","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"ban_to_knock","from":"ban","to":"knock","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}},
    {"name":"join_to_knock","from":"join","to":"knock","actor":"self","expected":{"outcome":"reject","reason_code":"fsm_transition_forbidden"}}
  ]
}
