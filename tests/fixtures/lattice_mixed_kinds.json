{
  "profile": "ak.profile.lattice_mixed_kinds_vectors.v1",
  "version": "2026-05-18",
  "comment": "CT-2 — verifies Arkret state resolution when a single Space has cells of different lattice types (cas-register + or-set + mv-register) updating concurrently. Spec authority: arkret-spec/spec/v1/zh/models/realm-and-space.md (lattice cell registry / cowrite_policy) + arkret-spec/spec/v1/zh/authz/event-auth-state-resolution.md §3 (lattice_op kinds) and §5.3 (per-lattice reference impl). Each cell family has its own lattice; a single Move MAY write multiple cells, and concurrent Moves are resolved per-cell by the cell's own lattice — there is no cross-cell winner reconstruction.",
  "notes": [
    "Move objects in these vectors describe protocol-level semantics. Wire-required fields space_id / hlc / sig are elided for readability per the CBS lattice fixture convention.",
    "Cell ids follow ak:cell:ak.component.<facet-path>.v<n>:<subject>; subject placeholders use safe ULIDs and dotted DID forms.",
    "expected_cell_states map cell_id → { lattice, value | heads | bottom } documenting the per-cell join after the Anchor batch."
  ],
  "vectors": [
    {
      "name": "cas_register_or_set_coexist",
      "description": "A single Move writes one cas-register cell (space.locked) and one or-set cell (space.tags) in the same batch. Both effects apply atomically; the two cells advance independently under their own lattices.",
      "pre_state": {
        "anchor": "ak:anchor:sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "cells": {
          "ak:cell:ak.component.realm.locked.v1:ak.realm.0196419b-0000-7000-8000-000000000000": {
            "lattice": "cas_register",
            "head": "ak:event:AboOf819TDn4X36iZWtVada6Ett2u_Oy_8F9XJDxA0gm",
            "value": false
          },
          "ak:cell:ak.component.realm.tags.v1:ak.realm.0196419b-0000-7000-8000-000000000000": {
            "lattice": "or_set",
            "active_tags": []
          }
        }
      },
      "move": {
        "id": "ak:event:AXgAdefW5lHi7e4pF2WIw-G6kahhIdaDRTVQPL7ritQM",
        "issuer_id": "ak:did_core:web:admin.example",
        "anchor_ref": "ak:anchor:sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "preconditions": [
          {
            "cell": "ak:cell:ak.component.realm.locked.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
            "predicate": {
              "op": "head_eq",
              "value": "ak:event:AboOf819TDn4X36iZWtVada6Ett2u_Oy_8F9XJDxA0gm"
            }
          }
        ],
        "effects": [
          {
            "cell": "ak:cell:ak.component.realm.locked.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
            "op": {
              "kind": "set",
              "value": true
            }
          },
          {
            "cell": "ak:cell:ak.component.realm.tags.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
            "op": {
              "kind": "add",
              "tag": "tag:launch",
              "value": "launch"
            }
          }
        ]
      },
      "expected": {
        "verify_move": "pass",
        "atomicity": "all_effects_or_none",
        "cell_states": {
          "ak:cell:ak.component.realm.locked.v1:ak.realm.0196419b-0000-7000-8000-000000000000": {
            "lattice": "cas_register",
            "value": true
          },
          "ak:cell:ak.component.realm.tags.v1:ak.realm.0196419b-0000-7000-8000-000000000000": {
            "lattice": "or_set",
            "active_tags": ["tag:launch"]
          }
        }
      }
    },
    {
      "name": "mv_register_concurrent_writers",
      "description": "Two concurrent Moves from different actors set the same mv-register cell (space.draft_title) in the same Anchor batch. mv-register never reduces to a single winner; per event-auth-state-resolution.md §5.3.2 the join exposes both values as multiple heads. bottom=expose is the normal case for mv-register: projection surfaces {status:'conflict', heads:[...]} rather than choosing.",
      "cell": "ak:cell:ak.component.realm.draft_title.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
      "lattice": {
        "type": "mv_register",
        "bottom": "expose"
      },
      "concurrent_moves": [
        {
          "id": "ak:event:AS0SeFp4K9gJ7dJU-USj6NamrbB1oErV6VePQBTjW3Lb",
          "issuer_id": "ak:did_core:web:alice.example",
          "effects": [
            {
              "cell": "ak:cell:ak.component.realm.draft_title.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
              "op": {
                "kind": "set",
                "value": "Launch Plan v1"
              }
            }
          ]
        },
        {
          "id": "ak:event:AfeHttDwx-zk7Rh6zo7caL11OGRimn53g67KylvQIr2F",
          "issuer_id": "ak:did_core:web:bob.example",
          "effects": [
            {
              "cell": "ak:cell:ak.component.realm.draft_title.v1:ak.realm.0196419b-0000-7000-8000-000000000000",
              "op": {
                "kind": "set",
                "value": "Launch Plan v2"
              }
            }
          ]
        }
      ],
      "expected": {
        "query": {
          "status": "conflict",
          "heads": [
            "ak:event:AS0SeFp4K9gJ7dJU-USj6NamrbB1oErV6VePQBTjW3Lb",
            "ak:event:AfeHttDwx-zk7Rh6zo7caL11OGRimn53g67KylvQIr2F"
          ],
          "values": ["Launch Plan v1", "Launch Plan v2"]
        },
        "last_write_wins": false,
        "rationale": "mv-register exposes all concurrent set values as heads; spec §5.3.2 forbids picking a single winner. Authorization paths MUST NOT express trust via mv-register."
      }
    },
