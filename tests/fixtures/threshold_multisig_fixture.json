{
  "profile": "ak.profile.threshold_multisig_vectors.v1",
  "version": "2026-08-13",
  "inherits": ["_shared/_canonical_dids.json"],
  "comment": "Threshold k-of-n anchor signing vectors per spec authz/event-auth-state-resolution.md §6 (anchorer cell threshold profile) and the live SDK aggregator arkret-rust-sdk/crates/wire/src/signer.rs::ThresholdAggregator. Validates the partial-signature collection state machine: (a) collecting >=k verified partials produces an aggregated MultiSignature whose signatures[].len() equals the number of collected partials; (b) collecting k-1 partials and calling aggregate() rejects (cotest reason: threshold_below_quorum); (c) a PartialSignature whose signer_did is not in the anchorer cell's `members[]` is rejected at admission, before the aggregator can count it toward the threshold; (d) duplicate signer_did partials are rejected by add_partial (cotest reason: duplicate_signer); (e) aggregate() runs the per-partial verifier exactly once per collected partial. Cotest drives the real ThresholdAggregator for every vector — the fixture pins the inputs and expected outcomes, the SDK produces the results.",
  "encoder": {
    "anchorer_cell_kind": "threshold",
    "scheme": "ed25519-multi",
    "aggregator": "arkret_wire::ThresholdAggregator",
    "wire_form": "NotarySig::Multi(MultiSignature{kind: MultiSig, signatures: [PayloadSignature]})",
    "canonical_body": "{\"body\":\"threshold-anchor-move\"}",
    "canonical_body_sha256": "sha256:15be7882eb1efc20ab2e32756cd5f19fbb26a09c283b555684cdaf568a5834f3"
  },
  "vectors": [
    {
      "name": "exact_k_of_n_partials_aggregate_to_multi",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 2,
        "rationale": "Exactly k=2 verified partials from distinct anchorer-cell members ⇒ aggregate() returns MultiSignature{kind=MultiSig, signatures.len()==2}. Each PayloadSignature carries the partial's verification_method id and the shared payload_digest."
      }
    },
    {
      "name": "k_plus_one_partials_aggregate_with_all_partials",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        },
        {
          "signer_did": "did:web:anchor3.example",
          "kid": "did:web:anchor3.example#key-1",
          "signature_b64": "ICEiIyQlJicoKSorLC0uLw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 3,
        "rationale": "k+1 partials still aggregate; ThresholdAggregator.aggregate() emits one PayloadSignature per collected partial. Receivers re-verify each independently."
      }
    },
    {
      "name": "individual_partial_verification_is_per_partial",
      "k": 2,
      "n": 2,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw",
          "individually_verified": true
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw",
          "individually_verified": true
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 2,
        "rationale": "aggregate() runs per-partial verifier (one call per partial). Both partials individually valid ⇒ MultiSignature emitted."
      }
    },
    {
      "name": "k_of_n_with_open_set_overlay_still_keys_off_threshold_k",
      "k": 3,
      "n": 5,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example",
        "did:web:anchor4.example",
        "did:web:anchor5.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor3.example",
          "kid": "did:web:anchor3.example#key-1",
          "signature_b64": "ICEiIyQlJicoKSorLC0uLw"
        },
        {
          "signer_did": "did:web:anchor5.example",
          "kid": "did:web:anchor5.example#key-1",
          "signature_b64": "QEFCQ0RFRkdISUpLTE1OTw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 3,
        "rationale": "3-of-5 with sparse member subset {1,3,5} ⇒ threshold met. Aggregator does not require contiguous member indices."
      }
    }
  ],
  "negative_vectors": [
    {
      "name": "k_minus_one_partials_rejected_threshold_below_quorum",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        }
      ],
      "expected": {
        "outcome": "reject",
        "reason_code": "threshold_below_quorum",
        "collected": 1,
        "required": 2,
        "rationale": "Only 1 partial collected; ThresholdAggregator.aggregate() returns Err with `threshold not met` (cotest reason: threshold_below_quorum)."
      }
    },
    {
