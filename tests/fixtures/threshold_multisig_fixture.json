{
  "profile": "cx.profile.threshold_multisig_vectors.v1",
  "version": "2026-05-09",
  "inherits": ["_shared/_canonical_dids.json"],
  "comment": "Round 22 — threshold k-of-n Anchor signing vectors per spec authz/event-auth-state-resolution.md §6 (anchorer cell threshold profile) and cokret-rust-sdk crates/core/src/signer.rs::ThresholdAggregator. Validates the partial-signature collection state machine: (a) collecting >=k verified partials produces an aggregated MultiSignature whose signatures[].len() == k; (b) collecting k-1 partials and calling aggregate() rejects with `threshold_below_quorum`; (c) PartialSignature whose signer_did is not in the anchorer cell's `members[]` rejected at admission; (d) duplicate signer_did partials deduped (second add_partial returns `duplicate_signer`); (e) aggregated signature verifies iff each partial individually verifies (one-call-per-partial). Each vector pins a normative input shape + outcome; no real signing is exercised — that lives in SDK signature crate unit tests. The validator is structural.",
  "encoder": {
    "anchorer_cell_kind": "threshold",
    "scheme": "ed25519-multi",
    "wire_form": "AnchorerSig::Multi(MultiSignature{kind: MultiSig, signatures[]})"
  },
  "vectors": [
    {
      "name": "exact_k_of_n_partials_aggregate_to_multi",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 2,
        "rationale": "Exactly k=2 verified partials from distinct anchorer-cell members ⇒ aggregate() returns MultiSignature{kind=MultiSig, signatures.len()==2}. Each MoveSignature carries the partial's verification_method id."
      }
    },
    {
      "name": "k_plus_one_partials_aggregate_with_all_partials",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        },
        {
          "signer_did": "did:web:anchor3.example",
          "kid": "did:web:anchor3.example#key-1",
          "signature_b64": "ICEiIyQlJicoKSorLC0uLw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 3,
        "rationale": "k+1 partials still aggregate; ThresholdAggregator.aggregate() emits one MoveSignature per collected partial. Receivers re-verify each independently."
      }
    },
    {
      "name": "individual_partial_verification_is_per_partial",
      "k": 2,
      "n": 2,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw",
          "individually_verified": true
        },
        {
          "signer_did": "did:web:anchor2.example",
          "kid": "did:web:anchor2.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw",
          "individually_verified": true
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 2,
        "rationale": "aggregate() runs per-partial verifier (one call per partial). Both partials individually valid ⇒ MultiSignature emitted."
      }
    },
    {
      "name": "k_of_n_with_open_set_overlay_still_keys_off_threshold_k",
      "k": 3,
      "n": 5,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example",
        "did:web:anchor4.example",
        "did:web:anchor5.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor3.example",
          "kid": "did:web:anchor3.example#key-1",
          "signature_b64": "ICEiIyQlJicoKSorLC0uLw"
        },
        {
          "signer_did": "did:web:anchor5.example",
          "kid": "did:web:anchor5.example#key-1",
          "signature_b64": "QEFCQ0RFRkdISUpLTE1OTw"
        }
      ],
      "expected": {
        "outcome": "aggregate_ok",
        "aggregated_signatures_len": 3,
        "rationale": "3-of-5 with sparse member subset {1,3,5} ⇒ threshold met. Aggregator does not require contiguous member indices."
      }
    }
  ],
  "negative_vectors": [
    {
      "name": "k_minus_one_partials_rejected_threshold_below_quorum",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        }
      ],
      "expected": {
        "outcome": "reject",
        "reason_code": "threshold_below_quorum",
        "collected": 1,
        "required": 2,
        "rationale": "Only 1 partial collected; ThresholdAggregator.aggregate() returns Err with `threshold not met` (cotest reason: threshold_below_quorum)."
      }
    },
    {
      "name": "zero_partials_rejected_threshold_below_quorum",
      "k": 1,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [],
      "expected": {
        "outcome": "reject",
        "reason_code": "threshold_below_quorum",
        "collected": 0,
        "required": 1,
        "rationale": "Zero partials; even k=1 is not met. aggregate() rejects."
      }
    },
    {
      "name": "partial_signer_not_in_member_set_rejected",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:attacker.example",
          "kid": "did:web:attacker.example#key-1",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        }
      ],
      "expected": {
        "outcome": "reject",
        "reason_code": "partial_signer_not_in_anchorer_set",
        "rationale": "did:web:attacker.example is NOT in the anchorer cell's `members[]`. Per-partial admission MUST reject before the aggregator counts the partial toward the threshold; verify_anchor enforces this on the receive side."
      }
    },
    {
      "name": "duplicate_signer_partial_rejected",
      "k": 2,
      "n": 3,
      "members": [
        "did:web:anchor1.example",
        "did:web:anchor2.example",
        "did:web:anchor3.example"
      ],
      "partials": [
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-1",
          "signature_b64": "AAECAwQFBgcICQoLDA0ODw"
        },
        {
          "signer_did": "did:web:anchor1.example",
          "kid": "did:web:anchor1.example#key-2",
          "signature_b64": "EBESExQVFhcYGRobHB0eHw"
        }
      ],
      "expected": {
        "outcome": "reject",
        "reason_code": "duplicate_signer",
        "rationale": "ThresholdAggregator.add_partial() rejects duplicate signer_did even with a different kid. The same signer cannot double-count toward the threshold; deduped to 1 effective partial < k=2."
      }
    }
  ]
}
