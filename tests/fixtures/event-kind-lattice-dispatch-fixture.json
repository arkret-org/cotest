  "vectors": [
    {
      "name": "every_active_reducer_input_durable_kind_with_cell_family_declares_one_lattice",
      "scope": "live_registry",
      "expected": {
        "outcome": "all_kinds_consistent",
        "rationale": "Every active+reducer_input+durable_event kind that declares cell_family MUST also declare a `lattice` field, and that lattice MUST be in the core set. Mirrors `validate_event_kind_registry` M11 invariant; this vector is the dual."
      }
    },
    {
      "name": "no_cell_family_appears_in_two_distinct_lattices",
      "scope": "live_registry",
      "expected": {
        "outcome": "single_lattice_per_cell_family",
        "rationale": "If two distinct event_kinds declare the same `cell_family` they MUST also declare the SAME `lattice`. A cell-family bound to two lattices is a wire-model drift bug — the receiver cannot dispatch to a single LatticeKind impl."
      }
    },
    {
      "name": "cell_family_namespace_is_ak_component",
      "scope": "live_registry",
      "expected": {
        "outcome": "namespace_ok",
        "rationale": "Every cell_family MUST start with `ak.component.`. Non-conforming families would not match any LatticeKind impl in `default_lattice_registry`."
      }
    },
    {
      "name": "bottom_mode_is_reject_or_expose",
      "scope": "live_registry",
      "expected": {
        "outcome": "bottom_mode_ok",
        "rationale": "Every reducer-input durable kind that declares cell_family MUST set bottom ∈ {reject, expose}. `reject` quarantines the cell on Bottom; `expose` surfaces multi-value to UX."
      }
    },
    {
      "name": "expected_or_set_families_resolve_to_or_set_in_live_registry",
      "scope": "expected_cell_family_lattice_bindings.or_set_families",
      "expected": {
        "outcome": "lattice_match",
        "lattice": "or_set",
        "rationale": "Every family in `expected_cell_family_lattice_bindings.or_set_families` MUST resolve to lattice=or-set in the live event-kind-registry. Drift from either side ⇒ fixture failure."
      }
    },
    {
      "name": "expected_cas_register_families_resolve_to_cas_register_in_live_registry",
      "scope": "expected_cell_family_lattice_bindings.cas_register_families",
      "expected": {
        "outcome": "lattice_match",
        "lattice": "cas_register",
        "rationale": "Every family in `expected_cell_family_lattice_bindings.cas_register_families` MUST resolve to lattice=cas-register in the live event-kind-registry."
      }
    },
    {
      "name": "expected_fsm_families_resolve_to_fsm_in_live_registry",
      "scope": "expected_cell_family_lattice_bindings.fsm_families",
      "expected": {
        "outcome": "lattice_match",
        "lattice": "fsm",
        "rationale": "Every family in `expected_cell_family_lattice_bindings.fsm_families` MUST resolve to lattice=fsm in the live event-kind-registry."
      }
    },
    {
      "name": "expected_ordered_log_families_resolve_to_ordered_log_in_live_registry",
      "scope": "expected_cell_family_lattice_bindings.ordered_log_families",
      "expected": {
        "outcome": "lattice_match",
        "lattice": "ordered_log",
        "rationale": "Per-issuer monotonic append families. Bottom ⇒ replay-protection rejection (duplicate issuer_seq)."
      }
    },
    {
      "name": "expected_mv_register_families_resolve_to_mv_register_in_live_registry",
      "scope": "expected_cell_family_lattice_bindings.mv_register_families",
      "expected": {
        "outcome": "lattice_match",
        "lattice": "mv_register",
        "rationale": "Concurrent multi-value families. Bottom=expose so UX renders both candidates."
      }
    }
  ],
  "negative_vectors": [
    {
      "name": "lattice_outside_core_set_rejected",
      "scope": "synthetic",
      "drift": {
        "kind": "non_core_lattice",
        "lattice": "lww-register"
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "lattice_not_in_core_set",
        "rationale": "lww-register / rga are extension-only lattices restricted to ui_affordance/content/draft/cosmetic cells via ak.profile.collaborative_text.v1. A reducer-input durable kind in the registry MUST NOT declare these as its lattice."
      }
    },
    {
      "name": "cell_family_outside_ak_component_namespace_rejected",
      "scope": "synthetic",
      "drift": {
        "kind": "wrong_namespace",
        "cell_family": "ak.cell.legacy.v1"
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "cell_family_invalid_namespace",
        "rationale": "Spec mandates cell_family starts with `ak.component.`. Any other prefix is a registry drift bug."
      }
    },
    {
      "name": "bottom_value_outside_reject_or_expose_rejected",
      "scope": "synthetic",
      "drift": {
        "kind": "invalid_bottom",
        "bottom": "ignore"
      },
      "expected": {
        "outcome": "reject",
        "reason_code": "bottom_invalid_value",
        "rationale": "Bottom mode must be `reject` (quarantine cell on Bottom) or `expose` (surface multi-value). `ignore` would silently drop conflicts — not allowed."
      }
    }
  ]
}
