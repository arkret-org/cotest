{
  "profile": "ak.profile.event_kind_lattice_dispatch_vectors.v1",
  "version": "2026-08-03",
  "comment": "Validates SDK-generated event cell writes against the independently executable lattice registry. This fixture intentionally contains no cell-family registry mirror.",
  "encoder": {
    "core_lattices": [
      "or_set",
      "mv_register",
      "cas_register",
      "fsm",
      "counter",
      "ordered_log"
    ],
    "valid_bottom_modes": [
      "reject",
      "expose",
      "inert"
    ],
    "descriptor_source": "arkret_wire::EVENT_KIND_DESCRIPTORS",
    "executable_source": "arkret_lattice_registry::lattice_bindings_for_sdk_registry"
  },
  "vectors": [
    {
      "name": "every_active_reducer_input_durable_kind_with_cell_family_declares_one_lattice",
      "scope": "live_registry",
      "expected": { "outcome": "all_kinds_consistent" }
    },
    {
      "name": "no_cell_family_appears_in_two_distinct_lattices",
      "scope": "live_registry",
      "expected": { "outcome": "single_lattice_per_cell_family" }
    },
    {
      "name": "cell_family_namespace_is_ak_component",
      "scope": "live_registry",
      "expected": { "outcome": "namespace_ok" }
    },
    {
      "name": "bottom_mode_is_reject_or_expose",
      "scope": "live_registry",
      "expected": { "outcome": "bottom_mode_ok" }
    },
    {
      "name": "sdk_descriptors_match_executable_lattice_registry",
      "scope": "sdk_and_executable_registry",
      "expected": { "outcome": "exact_closure" }
    }
  ],
  "negative_vectors": [
    {
      "name": "lattice_outside_core_set_rejected",
      "scope": "synthetic",
      "drift": { "kind": "non_core_lattice", "lattice": "lww-register" },
      "expected": { "outcome": "reject", "reason_code": "lattice_not_in_core_set" }
    },
    {
      "name": "cell_family_outside_ak_component_namespace_rejected",
      "scope": "synthetic",
      "drift": { "kind": "wrong_namespace", "cell_family": "ak.cell.legacy.v1" },
      "expected": { "outcome": "reject", "reason_code": "cell_family_invalid_namespace" }
    },
    {
      "name": "bottom_value_outside_reject_or_expose_rejected",
      "scope": "synthetic",
      "drift": { "kind": "invalid_bottom", "bottom": "ignore" },
      "expected": { "outcome": "reject", "reason_code": "bottom_invalid_value" }
    }
  ]
}
