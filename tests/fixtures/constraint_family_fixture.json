        "subtype": "window",
        "effect": "allow",
        "evaluation_class": "stateless",
        "not_before": "2026-05-09T00:00:00Z",
        "expires_at": "2026-12-31T23:59:59Z"
      },
      "expected": { "outcome": "shape_ok", "evaluation_class": "stateless", "fast_path_eligible": true }
    },
    {
