{
  "profile": "ck.profile.constraint_family_vectors.v1",
  "version": "2026-05-09",
  "comment": "C1 Round 23 — grant-constraint family × subtype coverage. Spec schemas/grant-constraint.schema.json declares 8 constraint_type families (temporal, field_access, type_restriction, scope_limitation, delegation_control, quota, claim_based, confidentiality) with optional subtype values. Each constraint_type carries a canonical evaluation_class (stateless / grant_local / space_state / external) which the validator uses to gate fast-path caching. Fixture covers all 8 families with at least one positive vector + one evaluation_class fast-path test per family.",
  "encoder": {
    "schema": "schemas/grant-constraint.schema.json",
    "valid_constraint_types": ["temporal", "field_access", "type_restriction", "scope_limitation", "delegation_control", "quota", "claim_based", "confidentiality"],
    "valid_evaluation_classes": ["stateless", "grant_local", "space_state", "external"],
    "valid_effects": ["allow", "deny", "quarantine", "require_review"]
  },
  "vectors": [
    {
      "name": "temporal_window",
      "constraint_type": "temporal",
      "subtype": "window",
      "constraint": {
