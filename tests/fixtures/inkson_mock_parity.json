{
  "comment": "T-P0-04 baseline requests for comparing inkson's e2e mock contract with a live soland process.",
  "cases": [
    {
      "id": "server_describe",
      "operation_id": "ck.server.query.describe",
      "method": "GET",
      "path": "/_cokret/describe"
    },
    {
      "id": "events_submit",
      "operation_id": "ck.self.events.command.submit",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "headers": { "x-cokret-request-id": "mock-parity-events-submit" },
      "body_template": "realm_create_event"
    },
    {
      "id": "events_list",
      "operation_id": "ck.self.events.query.scan",
      "method": "GET",
      "path": "/_cokret/self/events?realms=${realm_id}&limit=20",
      "auth": "alice"
    },
    {
      "id": "account_profile",
      "operation_id": "ck.self.account.query.viewer",
      "method": "GET",
      "path": "/_cokret/self/account/viewer",
      "auth": "alice"
    },
    {
      "id": "device_pair",
      "operation_id": "ck.gate.account.command.pair_device",
      "method": "POST",
      "path": "/_cokret/gate/account/device-pair",
      "auth": "alice",
      "live_skip_reason": "live soland requires a verified authorizing device; artifact gate still validates method/path and request/response schema",
      "body": {
        "pairing_code": "pairing-code",
        "new_device_pubkey": {
          "kty": "OKP",
          "kid": "ck:device:01999999-0000-7000-8000-000000000452",
          "alg": "EdDSA",
          "public_key": "emtleQ"
        },
        "challenge_signature": "c2ln",
        "display_name": "Paired Phone",
        "device_metadata": {
          "platform": "ios"
        }
      }
    },
    {
      "id": "realm_create",
      "operation_id": "ck.self.events.command.submit",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_2"
    },
    {
      "id": "space_create",
      "operation_id": "ck.self.events.command.submit",
      "method": "POST",
      "path": "/_cokret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_3"
    },
    {
      "id": "directory_describe",
      "operation_id": "ck.find.directory.query.describe",
      "method": "GET",
      "path": "/_cokret/find/directory/describe"
    },
    {
      "id": "directory_search_realms",
      "operation_id": "ck.find.directory.query.search_realms",
      "method": "POST",
      "path": "/_cokret/find/directory/search-realms",
      "body": { "query": "Mock Parity", "limit": 20 }
    },
    {
      "id": "keys_backups",
      "operation_id": "ck.self.keys.backups.query.list",
      "method": "GET",
      "path": "/_cokret/self/keys/backups",
      "auth": "alice"
    },
    {
      "id": "keys_backups_did_recovery_filter",
      "operation_id": "ck.self.keys.backups.query.list",
      "method": "GET",
      "path": "/_cokret/self/keys/backups?backup_class=did_recovery",
      "auth": "alice"
    },
    {
      "id": "recovery_policy",
      "operation_id": "ck.root.identity.recovery_policy.resource.get",
      "method": "GET",
      "path": "/_cokret/root/identity/recovery-policy",
      "auth": "alice"
    },
    {
      "id": "ephemeral",
      "operation_id": "ck.self.ephemeral.command.send",
      "method": "POST",
      "path": "/_cokret/self/ephemeral",
      "auth": "alice",
      "body_template": "typing_ephemeral"
    }
  ]
}
