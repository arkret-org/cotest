{
  "comment": "T-P0-04 baseline requests for comparing inkson's e2e mock contract with a live soland process.",
  "cases": [
    {
      "id": "server_describe",
      "operation_id": "ak.server.query.describe",
      "method": "GET",
      "path": "/_arkret/describe"
    },
    {
      "id": "events_submit",
      "operation_id": "ak.self.events.command.submit",
      "method": "POST",
      "path": "/_arkret/self/events",
      "auth": "alice",
      "headers": { "x-arkret-request-id": "mock-parity-events-submit" },
      "body_template": "realm_create_event"
    },
    {
      "id": "events_list",
      "operation_id": "ak.self.events.query.scan",
      "method": "GET",
      "path": "/_arkret/self/events?realms=${realm_id}&limit=20",
      "auth": "alice"
    },
    {
      "id": "account_profile",
      "operation_id": "ak.self.account.query.viewer",
      "method": "GET",
      "path": "/_arkret/self/account/viewer",
      "auth": "alice"
    },
    {
      "id": "device_pair",
      "operation_id": "ak.gate.account.command.pair_device",
      "method": "POST",
      "path": "/_arkret/gate/account/device-pair",
      "auth": "alice",
      "live_skip_reason": "live soland requires a verified authorizing device; artifact gate still validates method/path and request/response schema",
      "body": {
        "pairing_code": "pairing-code",
        "new_device_pubkey": {
          "kty": "OKP",
          "kid": "ak:device:01999999-0000-7000-8000-000000000452",
          "algorithm": "Ed25519",
          "key": "emtleQ"
        },
        "challenge_signature": "c2ln",
        "display_name": "Paired Phone",
        "device_metadata": {
          "platform": "ios"
        }
      }
    },
    {
      "id": "device_pairing_stage",
      "operation_id": "ak.open.device_pairing.command.stage",
      "method": "POST",
      "path": "/_arkret/open/device-pairing/requests",
      "live_skip_reason": "the live operation mints a fresh request id and pairing code; artifact and mock-format gates validate the stable request/response contract",
      "body": {
        "new_device_pubkey": {
          "kty": "OKP",
          "kid": "ak:device:01964137-0000-7000-8000-0000000000b2",
          "algorithm": "Ed25519",
          "key": "z6MkpTHR8VNsBxYAAWHut2Geadd9jSwuBV8xRoAnwWsdvktH"
        },
        "client_nonce": "Y290ZXN0LWRldmljZS1wYWlyaW5nLW5vbmNl",
        "display_name": "New device",
        "device_metadata": {
          "platform": "browser"
        }
      }
    },
    {
      "id": "device_pairing_resolve",
      "operation_id": "ak.open.device_pairing.query.resolve",
      "method": "POST",
      "path": "/_arkret/open/device-pairing/resolve",
      "live_skip_reason": "the deterministic mock token has no corresponding live staged record; artifact and mock-format gates validate the stable request/response contract",
      "body": {
        "pairing_token": "device-pairing-token"
      }
    },
    {
      "id": "device_pairing_status",
      "operation_id": "ak.open.device_pairing.query.status",
      "method": "POST",
      "path": "/_arkret/open/device-pairing/requests/status",
      "live_skip_reason": "the deterministic fixture credentials have no corresponding live staged record; artifact and mock-format gates validate the stable request/response contract",
      "body": {
        "device_pairing_request_id": "device_pairing_request:01964137-0000-7000-8000-0000000000c1",
        "pairing_code": "7H2K9M4Q"
      }
    },
    {
      "id": "realm_create",
      "operation_id": "ak.self.events.command.submit",
      "method": "POST",
      "path": "/_arkret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_2"
    },
    {
      "id": "space_create",
      "operation_id": "ak.self.events.command.submit",
      "method": "POST",
      "path": "/_arkret/self/events",
      "auth": "alice",
      "body_template": "realm_create_event_3"
    },
    {
      "id": "directory_describe",
      "operation_id": "ak.find.directory.query.describe",
      "method": "GET",
      "path": "/_arkret/find/directory/describe"
    },
    {
      "id": "directory_search_realms",
      "operation_id": "ak.find.directory.query.search_realms",
      "method": "POST",
      "path": "/_arkret/find/directory/search-realms",
      "body": { "query": "Mock Parity", "limit": 20 }
    },
    {
      "id": "keys_backups",
      "operation_id": "ak.self.keys.backups.query.list",
      "method": "GET",
      "path": "/_arkret/self/keys/backups",
      "auth": "alice"
    },
    {
      "id": "keys_backups_did_recovery_filter",
      "operation_id": "ak.self.keys.backups.query.list",
      "method": "GET",
      "path": "/_arkret/self/keys/backups?backup_kind=did_recovery",
      "auth": "alice"
    },
    {
      "id": "recovery_policy",
      "operation_id": "ak.root.identity.recovery_policy.resource.get",
      "method": "GET",
      "path": "/_arkret/root/identity/recovery-policy",
      "auth": "alice"
    },
    {
      "id": "signal",
      "operation_id": "ak.self.signal.command.send",
      "method": "POST",
      "path": "/_arkret/self/signal",
      "auth": "alice",
      "body_template": "typing_signal"
    }
  ]
}
