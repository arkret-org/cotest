{
  "profile": "cx.profile.error_code_registry_coverage_vectors.v1",
  "version": "2026-05-09",
  "comment": "A4 Round 23 — error code registry coverage. Validator asserts: (a) every code in error-code-registry.json carries http_status (integer in canonical 4xx/5xx range), scope ∈ {client, server, both}, and a non-empty description; (b) any error code referenced by an event-payload schema enum (mls.commit_failed.failure_stage / quarantine reasons / etc.) — when surfaced via the registry — appears in the registry by name. Negative vectors cover (a) missing http_status, (b) invalid scope value, (c) referenced code missing from registry.",
  "encoder": {
    "error_code_registry": "registry/error-code-registry.json",
    "valid_scopes": ["client", "server", "both", "endpoint", "service_call"],
    "min_http_status": 400,
    "max_http_status": 599
  },
  "expected_referenced_codes": [
    {
      "code": "schema_violation",
      "expected_http_status": 422,
      "expected_scope": "both",
      "referenced_in": "envelope validation"
    },
    {
      "code": "unauthenticated",
      "expected_http_status": 401,
      "expected_scope": "both",
      "referenced_in": "auth gate"
    },
    {
      "code": "capability_denied",
      "expected_http_status": 403,
      "expected_scope": "both",
      "referenced_in": "capability evaluation"
    },
    {
      "code": "policy_violation",
      "expected_http_status": 403,
      "expected_scope": "both",
      "referenced_in": "read-receipt disclosure / policy"
    },
    {
      "code": "invalid_signature",
      "expected_http_status": 401,
      "expected_scope": "both",
      "referenced_in": "Move/Anchor signature verify"
    }
  ],
  "vectors": [
    {
      "name": "every_code_has_http_status",
      "scope": "live_registry",
      "expected": { "outcome": "all_codes_have_http_status", "rationale": "Every codes[*].http_status MUST be an integer 400 ≤ s ≤ 599." }
    },
    {
      "name": "every_code_has_scope_in_known_set",
      "scope": "live_registry",
      "expected": { "outcome": "all_codes_have_scope", "rationale": "Every codes[*].scope MUST be one of {client, server, both}." }
    },
    {
      "name": "every_code_has_non_empty_description",
      "scope": "live_registry",
      "expected": { "outcome": "all_codes_have_description", "rationale": "Every codes[*].description MUST be a non-empty string." }
    },
    {
      "name": "schema_violation_resolves",
      "scope": "live_registry",
      "code": "schema_violation",
      "expected": { "outcome": "code_match", "http_status": 422, "scope": "both" }
    },
    {
      "name": "capability_denied_resolves",
      "scope": "live_registry",
      "code": "capability_denied",
      "expected": { "outcome": "code_match", "http_status": 403, "scope": "both" }
    },
    {
      "name": "invalid_signature_resolves",
      "scope": "live_registry",
      "code": "invalid_signature",
      "expected": { "outcome": "code_match", "http_status": 401, "scope": "both" }
    }
  ],
  "negative_vectors": [
    {
      "name": "unknown_referenced_code",
      "synthetic_code": "totally_fake_error_code",
      "drift": { "kind": "code_not_in_registry" },
      "expected": { "outcome": "reject", "reason_code": "code_unknown" }
    },
    {
      "name": "invalid_scope_value",
      "synthetic_scope": "weird_scope",
      "drift": { "kind": "scope_invalid" },
      "expected": { "outcome": "reject", "reason_code": "scope_drift" }
    },
    {
      "name": "out_of_range_http_status",
      "synthetic_http_status": 200,
      "drift": { "kind": "http_status_out_of_range" },
      "expected": { "outcome": "reject", "reason_code": "http_status_drift" }
    }
  ]
}
