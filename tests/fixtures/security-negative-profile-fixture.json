    {
      "name": "bad_signature_correct_digest_forged_jws_rejects",
      "category": "bad_signature",
      "operation_id": "ak.self.events.command.submit.v1",
      "comment": "event_digest binds the canonical Event bytes correctly, but the detached JWS signature is forged. A real Ed25519 verification MUST reject it \u2014 a bare digest comparison would not. signing_public_key_hex is the verifying key resolved from proof.verification_method.",
      "input": {
        "signing_public_key_hex": "ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c",
        "event": {
          "event_id": "ak:event:AdyEwgVhmwXJsVM0LgEjIhkO3j0H9seuhNhspGSeeeBd",
          "kind": "ak.message.create",
          "realm_id": "ak:realm:ASkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkp",
          "scope_ref": {
            "kind": "realm",
            "realm_id": "ak:realm:ASkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkpKSkp"
          },
          "actor_id": {
            "kind": "account",
            "account_id": {
              "principal_id": "ak:did_core:web:alice.example",
              "station_id": "ak:did_core:web:station.example"
            }
          },
          "created_at": "2026-05-02T00:00:00.000Z",
          "payload": {
            "strand_id": "ak:strand:AT3ARBdH1FM6GjXK9ulTx-YMvQOXys39dlUzZV6KyID9",
            "track_name": "discussion",
            "content": {
              "kind": "ak.content.text",
              "body": "signed body",
              "format": "plain"
            }
          },
          "producer_proof": {
            "kind": "detached_jws",
            "verification_method": "did:web:alice.example#device",
            "event_digest": "sha256:dc84c205619b05c9b153342e012322190ede3d07f6c7ae84d86ca4649e79e05d",
            "created_at": "2026-05-02T00:00:00.000Z",
            "jws": "eyJhbGciOiJFZDI1NTE5In0..AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
          }
        }
      },
      "expected": {
        "decision": "reject",
        "error_code": "signature_invalid",
        "hard_fail": true
      }
    },
