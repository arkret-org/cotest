    "anchor_id": "ak:anchor:sha256:<sha256-hex>",
    "frontier_canonical_form": "ascending lex sort of ak:anchor:... leaf ids in JSON array",
    "state_root_basis": "merkle-leaf hash over canonical (cell_id, lattice_join_value) pairs"
  },
