{
  "suite": "blind_payload_sanitizer",
  "version": 1,
  "description": "T1.1 conformance vectors for the unified push blind-payload sanitizer (contrix-rust-sdk / chime / floria). Positive cases must pass `sanitize_blind_payload`; negative cases must fail with the documented `reason_code` and (where given) `field_path`.",
  "positive_cases": [
    {
      "name": "minimal_blind_wakeup",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "message"
        }
      }
    },
    {
      "name": "with_push_hint_literal",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "incoming_call",
          "push_hint": "incoming_call"
        }
      }
    },
    {
      "name": "with_push_hint_l10n_key",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "mention",
          "push_hint": "l10n_key:message.new"
        }
      }
    },
    {
      "name": "with_badge_and_unread_count",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "message",
          "badge": 1,
          "unread_count": 3
        }
      }
    },
    {
      "name": "with_counts_object",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "message",
          "counts": { "unread": 4 }
        }
      }
    },
    {
      "name": "bare_base64url_push_target_id",
      "payload": {
        "notification": {
          "push_target_id": "abcdefghijklmnopqrstuv",
          "wakeup_kind": "message"
        }
      }
    },
    {
      "name": "custom_wakeup_kind_snake_case",
      "payload": {
        "notification": {
          "push_target_id": "cx:pseudonym:push:01HYZ8Z000000000000000",
          "wakeup_kind": "bg_refresh"
        }
      }
    }
  ],
  "negative_cases": [
