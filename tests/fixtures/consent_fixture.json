{
  "profile": "ak.profile.consent_vectors.v1",
  "version": "2026-08-22",
  "inherits": ["_shared/_canonical_dids.json"],
  "comment": "Holder-private consent-cell OR-Set semantics. The caller-minted typed consent_id is the cell subject: ak:cell:ak.component.consent.grant.v1:<consent_id>. The first accepted grant freezes the exact (peer, consent_scope) intent for that cell; later grants add Event-derived dots only for the same intent, and revokes remove only explicitly observed dots. Downstream invite/message checks are operation-admission checks against the holder PCR projection, never cross-Realm CBA preconditions.",
  "vectors": [
    {
      "name": "grant_then_invite_accepts",
      "comment": "Holder grants invite consent to the peer. The subsequent operation-admission check reads the holder PCR projection and resolves active.",
      "moves": [
        {
          "move_id": "ak:event:AZC-U6IhvshOPx6I2sZcwUIipTolibFEKZrW4-KHFwXY",
          "kind": "ak.consent.grant",
          "actor_id": "did:web:alice.example",
          "consent_id": "ak:consent:01964100-0000-7000-8000-000000000001",
          "effects": [
            {
              "cell": "ak:cell:ak.component.consent.grant.v1:ak:consent:01964100-0000-7000-8000-000000000001",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ak:event:ASWDS-DvTMGsI8ra8IMcrWzD1L3BUF2D3bFEvSpZJB01",
          "kind": "ak.invite.send",
          "actor_id": "did:web:bob.example",
          "admission_checks": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "consent_id": "ak:consent:01964100-0000-7000-8000-000000000001",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "accept" }
        }
      ]
    },
    {
      "name": "revoke_after_grant_blocks_invite",
      "comment": "Causal remove names the prior grant dot explicitly. The following operation-admission check resolves no_consent and rejects with consent_required.",
      "moves": [
        {
          "move_id": "ak:event:ASRboSxLt55ezeNBXCa9odsuRrRWsJ_J49TgWKtyTcWd",
          "kind": "ak.consent.grant",
          "actor_id": "did:web:alice.example",
          "consent_id": "ak:consent:01964100-0000-7000-8000-000000000002",
          "effects": [
            {
              "cell": "ak:cell:ak.component.consent.grant.v1:ak:consent:01964100-0000-7000-8000-000000000002",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ak:event:AerVVhAWptFKZiFBDlob36MUqKQML7m1Hilkfvbtzngz",
          "kind": "ak.consent.revoke",
          "actor_id": "did:web:alice.example",
          "consent_id": "ak:consent:01964100-0000-7000-8000-000000000002",
          "effects": [
            {
              "cell": "ak:cell:ak.component.consent.grant.v1:ak:consent:01964100-0000-7000-8000-000000000002",
              "op": "or_set_remove",
              "removes": ["ak:event:ASRboSxLt55ezeNBXCa9odsuRrRWsJ_J49TgWKtyTcWd:0"]
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ak:event:AbLUaNO9m_tRCJn4qAM03Ym0bFcN-oRmeEHjTinQpPUu",
          "kind": "ak.invite.send",
          "actor_id": "did:web:bob.example",
          "admission_checks": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "consent_id": "ak:consent:01964100-0000-7000-8000-000000000002",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "reject", "reason_code": "consent_required" }
        }
      ]
    },
    {
      "name": "scope_any_covers_all_scopes",
      "comment": "scope=any tag in the or-set covers all consent scopes (invite, direct_message, voice_call, video_call, presence). A call invite under any-scope is accepted without an explicit voice_call tag.",
