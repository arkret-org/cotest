{
  "profile": "cx.profile.consent_vectors.v1",
  "version": "2026-05-09",
  "inherits": ["_shared/_canonical_dids.json"],
  "comment": "Holder-private consent cell (or-set lattice) Move semantics. Spec: identity/consent-model.md + authz/event-auth-state-resolution.md (Move/Anchor/Lattice). Each consent grant Move adds a tag (peer, scope) to the holder-keyed or-set cell `ck:cell:cx.component.consent.grant.v1:<holder>`; each consent revoke Move issues a causal remove of one or more existing tags by their op_ids. Consent membership is the join (active set) of the cell after applying every Move; an invite Move's `require_consent` precondition reads that active set. C19.A wire-break (spec 2026-05-09): typed cell ids carry holder DIDs as the subject; previous fixtures used a synthetic `ck:consent:<ulid>` id that is no longer registered as a typed UUIDv7 id_kind.",
  "vectors": [
    {
      "name": "grant_then_invite_accepts",
      "comment": "Holder grants consent for `invite` scope to peer; the or-set cell join contains (bob, invite). The subsequent invite Move's `require_consent` precondition resolves true and Move is accepted.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000001",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000002",
          "kind": "cx.invite.send",
          "actor_id": "did:web:bob.example",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "accept" }
        }
      ]
    },
    {
      "name": "revoke_after_grant_blocks_invite",
      "comment": "Causal remove of the prior grant op (or-set or_set_remove referencing the grant move_id). After Move 2, the cell join no longer contains (bob, invite); Move 3's `consent_active` precondition resolves false and the Move is rejected with consent_required.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000010",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000011",
          "kind": "cx.consent.revoke",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_remove",
              "removes": ["ck:event:01970e58-0000-7000-8000-000000000010"]
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000012",
          "kind": "cx.invite.send",
          "actor_id": "did:web:bob.example",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "reject", "reason_code": "consent_required" }
        }
      ]
    },
    {
      "name": "scope_any_covers_all_scopes",
      "comment": "scope=any tag in the or-set covers all consent scopes (invite, direct_message, voice_call, video_call, presence). A call invite under any-scope is accepted without an explicit voice_call tag.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000020",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "any" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000021",
          "kind": "cx.call.invite",
          "actor_id": "did:web:bob.example",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:web:bob.example",
              "scope": "voice_call"
            }
          ],
          "payload": { "target": "did:web:alice.example", "media": "voice" },
          "expected": { "outcome": "accept" }
        }
      ]
    },
    {
      "name": "pseudonym_did_consent_accepts",
      "comment": "Pseudonym DID peers are valid or-set tag values. Cell join is identity-provenance-agnostic.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000030",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": {
                "peer": "did:ck:psd-z9z9z9z9z9z9z9z9z9z9z9",
                "scope": "direct_message"
              }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000031",
          "kind": "cx.message.create",
          "actor_id": "did:ck:psd-z9z9z9z9z9z9z9z9z9z9z9",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:ck:psd-z9z9z9z9z9z9z9z9z9z9z9",
              "scope": "direct_message"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "accept" }
        }
      ]
    },
    {
      "name": "require_consent_profile_blocks_unconsented_invite",
      "comment": "When the receiving Space pins the require_consent component, the invite Move's `consent_active` precondition fails closed because the holder's or-set has no matching tag. Move is rejected with consent_required.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000040",
          "kind": "cx.invite.send",
          "actor_id": "did:web:bob.example",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "reject", "reason_code": "consent_required" }
        }
      ]
    },
    {
      "name": "idempotent_re_grant_after_revoke",
      "comment": "Causal or-set: a fresh grant Move after a revoke creates a new tag op_id distinct from the previously-removed op. The cell join now contains the new tag, and the invite is accepted again.",
      "moves": [
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000050",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000051",
          "kind": "cx.consent.revoke",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_remove",
              "removes": ["ck:event:01970e58-0000-7000-8000-000000000050"]
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000052",
          "kind": "cx.consent.grant",
          "actor_id": "did:web:alice.example",
          "effects": [
            {
              "cell": "ck:cell:cx.component.consent.grant.v1:did:web:alice.example",
              "op": "or_set_add",
              "tag": { "peer": "did:web:bob.example", "scope": "invite" }
            }
          ],
          "expected": { "outcome": "accept" }
        },
        {
          "move_id": "ck:event:01970e58-0000-7000-8000-000000000053",
          "kind": "cx.invite.send",
          "actor_id": "did:web:bob.example",
          "preconditions": [
            {
              "kind": "consent_active",
              "holder": "did:web:alice.example",
              "peer": "did:web:bob.example",
              "scope": "invite"
            }
          ],
          "payload": { "target": "did:web:alice.example" },
          "expected": { "outcome": "accept" }
        }
      ]
    }
  ]
}
